---
const slides = [
  {
    image: '/images/home.jpg',
    title: 'One Healing',
    quote: 'Eνας ιστότοπος για την υγεία, σωματική και ψυχική.\n"Ωφελέειν ή μη βλάπτειν."   Ιπποκράτης',
  },
  {
    image: '/images/slide2.jpg',
    title: '',
    quote: '“Η αληθινή όραση βλέπει το μικρό και ασήμαντο. Η δύναμη γνωρίζει πως να ενδίδει”\n            Λάο Τσε',
  },
  {
    image: '/images/slide2.jpg',
    title: '',
    quote: '"Στο ταξίδι προς το φως, κάθε βήμα έχει το όφελος ενός βήματος, κάθε μέρα έχει την αποκομιδή μιας μέρας."\n            Λίου Ι Μινγκ σε σχόλιο για το Ι Τσινγκ',
  },
  {
    image: '/images/slide3.jpg',
    title: '',
    quote: '"Η δύναμη της κενότητας δεν προκύπτει από μία μόνο κατάσταση ή ένα μόνο συναίσθημα.\nΠροκύπτει όταν όλα περιλαμβάνονται. Είναι σαν ένα παζλ." \n              Μάνουελ Σοχ',
  },
];
---

<div class="tm-sliderbar uk-grid uk-clearfix" data-uk-grid-match="{target:'> .uk-width-1-1'}">
  <!-- Left 2/3 Slideshow -->
  <div class="tm-slider tm-padding-remove uk-float-left uk-width-1-1 uk-width-medium-2-3">
    <div>
      <div 
        id="hero-slideshow" 
        class="wk-slideshow wk-slideshow-home uk-nbfc" 
        style="position: relative; width: 100%; height: 414px; overflow: hidden; background: #000;"
      >
        <div style="position: relative; width: 100%; height: 100%;">
          <ul class="slides" style="position: relative; width: 100%; height: 100%; list-style: none; margin: 0; padding: 0;">
            {slides.map((s, idx) => (
              <li 
                class="slide-item" 
                style={`position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: ${idx === 0 ? '1' : '0'}; transition: opacity 0.8s ease-in-out; pointer-events: ${idx === 0 ? 'auto' : 'none'}; z-index: ${idx === 0 ? '2' : '1'};`}
                data-index={idx}
              >
                <div class="wk-content clearfix" style="width: 100%; height: 100%;">
                  <img 
                    src={s.image} 
                    alt={s.title || `slide ${idx + 1}`} 
                    style="width: 100%; height: 100%; object-fit: cover; display: block;" 
                  />
                </div>
              </li>
            ))}
          </ul>

          <!-- Next / Prev Buttons -->
          <div id="slide-next" class="next" style="cursor: pointer; z-index: 10;"></div>
          <div id="slide-prev" class="prev" style="cursor: pointer; z-index: 10;"></div>

          <!-- Dynamic Caption -->
          <div id="slide-caption" class="caption" style="display: block; opacity: 1; z-index: 5;">
            <h1 id="caption-title" style="display: block;">
              <a href="#">One Healing</a>
            </h1>
            <p id="caption-text" style="white-space: pre-line;">
              Eνας ιστότοπος για την υγεία, σωματική και ψυχική.
              &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"Ωφελέειν ή μη βλάπτειν."&nbsp;&nbsp;&nbsp;Ιπποκράτης
            </p>
          </div>
        </div>

        <!-- Dot Indicators -->
        <ul id="slide-nav" class="nav" style="z-index: 10;">
          {slides.map((_, idx) => (
            <li class={idx === 0 ? 'active' : ''} data-index={idx} style="cursor: pointer;">
              <span></span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- Right 1/3 Promo Caption Blocks -->
  <div class="tm-slider-right tm-padding-remove uk-float-right uk-scrollable-text uk-width-1-1 uk-width-medium-1-3">
    <div>
      <!-- Block 1: Βελονισμός -->
      <div class="tm-caption-block uk-grid">
        <div class="uk-width-8-10 tm-caption-text">
          <h3>
            <a href="/el/therapeftiki-proseggisi/velonismos">Βελονισμός</a>
          </h3>
          <p>
            Με βάση τη μέθοδο Balance Method<br />του dr Tan.
          </p>
        </div>
        <div class="tm-caption-icon uk-width-2-10">
          <span class="uk-block-icon uk-float-right uk-icon-7s-target"></span>
        </div>
      </div>

      <!-- Block 2: Ψυχοθεραπεία -->
      <div class="tm-caption-block uk-grid">
        <div class="uk-width-8-10 tm-caption-text">
          <h3>
            <a href="/el/therapeftiki-proseggisi/onehealing">Ψυχοθεραπεία</a>
          </h3>
          <p>
            Aτομικές συνεδρίες και ομαδική θεραπεία. Trauma Informed Therapy. Sessions in English. Sesiones en Español.
          </p>
        </div>
        <div class="tm-caption-icon uk-width-2-10">
          <span class="uk-block-icon uk-float-right uk-icon-7s-users"></span>
        </div>
      </div>

      <!-- Block 3: Ψυχιατρική -->
      <div class="tm-caption-block uk-grid">
        <div class="uk-width-8-10 tm-caption-text">
          <h3>
            <a href="/el/therapeftiki-proseggisi/psychiatriki">Ψυχιατρική</a>
          </h3>
          <p>
            Σύγχρονη, evidence based ιατρική στην υπηρεσία της ψυχικής υγείας.
          </p>
        </div>
        <div class="tm-caption-icon uk-width-2-10">
          <span class="uk-block-icon uk-float-right uk-icon-7s-gift"></span>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ slides }}>
  (function() {
    let currentIndex = 0;
    const items = document.querySelectorAll('#hero-slideshow .slide-item');
    const navDots = document.querySelectorAll('#slide-nav li');
    const captionTitle = document.getElementById('caption-title');
    const captionText = document.getElementById('caption-text');
    const prevBtn = document.getElementById('slide-prev');
    const nextBtn = document.getElementById('slide-next');

    if (!items.length) return;

    function showSlide(index) {
      if (index < 0) index = items.length - 1;
      if (index >= items.length) index = 0;
      currentIndex = index;

      items.forEach((item, i) => {
        if (i === currentIndex) {
          item.style.opacity = '1';
          item.style.zIndex = '2';
          item.style.pointerEvents = 'auto';
        } else {
          item.style.opacity = '0';
          item.style.zIndex = '1';
          item.style.pointerEvents = 'none';
        }
      });

      navDots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });

      const s = slides[currentIndex];
      if (captionTitle) {
        if (s.title) {
          captionTitle.style.display = 'block';
          captionTitle.innerHTML = `<a href="#">${s.title}</a>`;
        } else {
          captionTitle.style.display = 'none';
        }
      }
      if (captionText) {
        captionText.textContent = s.quote || '';
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        showSlide(currentIndex - 1);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        showSlide(currentIndex + 1);
      });
    }

    navDots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        showSlide(i);
      });
    });

    let autoTimer = setInterval(() => {
      showSlide(currentIndex + 1);
    }, 10000);

    const container = document.getElementById('hero-slideshow');
    if (container) {
      container.addEventListener('mouseenter', () => clearInterval(autoTimer));
      container.addEventListener('mouseleave', () => {
        clearInterval(autoTimer);
        autoTimer = setInterval(() => showSlide(currentIndex + 1), 10000);
      });
    }
  })();
</script>
