---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const isActive = (path: string) => {
  if (path === '/el/') {
    return currentPath === '/el/' || currentPath === '/' || currentPath === '/el';
  }
  return currentPath.startsWith(path);
};
---

<div class="tm-mainheader">
  <nav class="tm-navbar uk-navbar" data-uk-sticky="">
    <ul class="uk-navbar-nav uk-hidden-small">
      <li class={isActive('/el/') ? 'uk-active' : ''}>
        <a href="/el/">Αρχικη</a>
      </li>
      <li class={isActive('/el/viografiko') ? 'uk-active' : ''}>
        <a href="/el/viografiko">Βιογραφικo</a>
      </li>
      <li 
        class={`uk-parent ${isActive('/el/therapeftiki-proseggisi') ? 'uk-active' : ''}`} 
        data-uk-dropdown="{'preventflip':'y'}" 
        aria-haspopup="true" 
        aria-expanded="false"
      >
        <a href="/el/therapeftiki-proseggisi">Θεραπευτικη Προσεγγιση</a>
        <div class="uk-dropdown uk-dropdown-navbar uk-dropdown-width-1">
          <div class="uk-grid uk-dropdown-grid">
            <div class="uk-width-1-1">
              <ul class="uk-nav uk-nav-navbar">
                <li>
                  <a href="/el/therapeftiki-proseggisi/velonismos">Βελονισμός</a>
                </li>
                <li>
                  <a href="/el/therapeftiki-proseggisi/onehealing">Ψυχοθεραπεία</a>
                </li>
                <li>
                  <a href="/el/therapeftiki-proseggisi/psychiatriki">Ψυχιατρική</a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </li>
      <li class={isActive('/el/syxnes-erotiseis') ? 'uk-active' : ''}>
        <a href="/el/syxnes-erotiseis">Συχνες Ερωτησεις</a>
      </li>
      <li class={isActive('/el/istologio') ? 'uk-active' : ''}>
        <a href="/el/istologio">Ιστολογιο</a>
      </li>
      <li class={isActive('/el/prosopikes-martyries') ? 'uk-active' : ''}>
        <a href="/el/prosopikes-martyries">Προσωπικες Μαρτυριες</a>
      </li>
      <li class={isActive('/el/epikoinonia') ? 'uk-active' : ''}>
        <a href="/el/epikoinonia">Επικοινωνια</a>
      </li>
    </ul>

    <!-- Mobile Toggle -->
    <a href="#offcanvas" class="uk-navbar-toggle uk-visible-small" data-uk-offcanvas=""></a>

    <!-- Mobile Brand Logo -->
    <div class="uk-navbar-content uk-visible-small">
      <a class="tm-logo-small" href="/el/">
        <img 
          src="/images/logo/One_Healing___Logo___mirror___transparent_background1.png" 
          alt="One Healing Logo" 
          width="100" 
          height="55" 
          style="max-height: 45px; width: auto;"
        />
      </a>
    </div>
  </nav>
</div>
