---
// Dynamic dates for calendar display
const monthName = "Οκτώβριος";
const year = "2026";
---

<div class="uk-panel uk-panel-box">
  <div style="margin:0px;padding:0px;border-width:0px;">
    <table class="mod_events_monthyear" style="width:100%;">
      <tbody>
        <tr>
          <td>
            <div class="mod_events_link">&laquo;</div>
          </td>
          <td>
            <div class="mod_events_link">&lt;</div>
          </td>
          <td style="text-align:center;">
            <a class="mod_events_link" href="/el/calendar/monthcalendar/2026/10/-" title="Μετάβαση στον τρέχοντα μήνα του ημερολογίου">{monthName}</a>
            <a class="mod_events_link" href="/el/calendar/eventsbyyear/2026/-" title="Μετάβαση στο τρέχον έτος του ημερολογίου">{year}</a>
          </td>
          <td>
            <div class="mod_events_link">&gt;</div>
          </td>
          <td>
            <div class="mod_events_link">&raquo;</div>
          </td>
        </tr>
      </tbody>
    </table>

    <table class="mod_events_table" style="width:100%;">
      <tbody>
        <tr class="mod_events_dayname">
          <td class="mod_events_td_dayname"><span class="sunday">Κ</span></td>
          <td class="mod_events_td_dayname">Δ</td>
          <td class="mod_events_td_dayname">Τ</td>
          <td class="mod_events_td_dayname">Τ</td>
          <td class="mod_events_td_dayname">Π</td>
          <td class="mod_events_td_dayname">Π</td>
          <td class="mod_events_td_dayname"><span class="saturday">Σ</span></td>
        </tr>
        <tr>
          <td class="mod_events_td_dayoutofmonth">27</td>
          <td class="mod_events_td_dayoutofmonth">28</td>
          <td class="mod_events_td_dayoutofmonth">29</td>
          <td class="mod_events_td_dayoutofmonth">30</td>
          <td class="mod_events_td_daynoevents"><a class="mod_events_daylink" href="/el/calendar/eventsbyday/2026/10/1/-">1</a></td>
          <td class="mod_events_td_daynoevents"><a class="mod_events_daylink" href="/el/calendar/eventsbyday/2026/10/2/-">2</a></td>
