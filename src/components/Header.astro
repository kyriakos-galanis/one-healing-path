---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<!-- TM Toolbar -->
<div class="tm-toolbar uk-clearfix">
  <div class="uk-float-left">
    <div class="uk-panel">
      <p>
        <a 
          href="/el/epikoinonia" 
          target="_self" 
          class="uk-icon-button uk-icon-envelope-o" 
          title="Επικοινωνία"
        ></a>
      </p>
    </div>
  </div>

  <div class="uk-float-right">
    <div class="uk-panel">
      <p>
        <a 
          href="https://www.facebook.com/profile.php?id=61552501891015" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="uk-icon-button uk-icon-facebook" 
          title="Facebook"
        ></a>
      </p>
    </div>
  </div>

  <div class="uk-navbar-flip">
    <div class="uk-hidden-small">
      <form action="/el/istologio" method="get" class="uk-search">
        <input 
          class="uk-search-field" 
          type="text" 
          name="q" 
          placeholder="Αναζήτηση..." 
          autocomplete="off"
        />
      </form>
    </div>
  </div>
</div>

<!-- TM Headerbar -->
<div class="tm-headerbar uk-hidden-small uk-flex uk-flex-middle uk-flex-space-between">
  <a class="tm-logo" href="/el/">
    <p>
      <span style="font-size: 24pt;">
        <img 
          src="/images/logo/One_Healing___Logo___mirror___transparent_background1.png" 
          alt="One Healing Logo mirror transparent background1" 
          width="230" 
          height="126" 
        />
      </span>
    </p>
  </a>

  <div class="tm-header-right uk-flex uk-flex-right">
    <div>
      <p style="text-align: center;">
        <span style="font-size: 15pt;">
          <span style="color: #a3e9ec;">
            <span style="font-size: 18pt;">
              <span style="font-family: symbol;">
                <span style="font-family: tahoma, arial, helvetica, sans-serif;">
                  "I feel that there is nothing more truly artistic than to love people"&nbsp; Vincent Van Gogh
                </span>
              </span>
            </span>
          </span>
          <br />
        </span>
      </p>
    </div>
  </div>
</div>
