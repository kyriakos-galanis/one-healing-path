---
interface Props {
  article: {
    id: string;
    title: string;
    slug: string;
    date: string;
    date_day: string;
    category: string;
    category_slug: string;
    author: string;
    image: string;
    intro: string;
  };
}

const { article } = Astro.props;
---

<article class="itemView groupLeading" itemscope="" itemtype="https://schema.org/Article">
  <header>
    <time datetime={article.date} itemprop="dateCreated">
      <span class="uk-blog-date">
        <span class="tm-article-date-day">{article.date_day}</span>
      </span>
    </time>
    <h1 itemprop="name">
      <a href={`/el/item/${article.slug}`}>
        {article.title}
      </a>
    </h1>
    <ul>
      <li class="itemDateCreated">
        {article.date} |
      </li>
      <li class="itemCategory">
        <span>Κατηγορία</span>
        <a href={`/el/itemlist/category/${article.category_slug}`}>
          {article.category}
        </a>
      </li>
      <li class="itemAuthor" itemscope="" itemtype="https://schema.org/Person">
        Γράφτηκε από
        <a href="/el/itemlist/user/655-panagiwthsgkinhsmdcac" rel="author">
          <span itemprop="name">{article.author}</span>
        </a>
      </li>
      <li class="itemComments">
        <a href={`/el/item/${article.slug}#itemCommentsAnchor`}>
          <i class="uk-icon-comment-alt"></i> Σχολιάστε πρώτοι!
        </a>
      </li>
    </ul>
  </header>

  <div class="itemBlock">
    <div class="itemBody" itemprop="articleBody">
      <div class="itemIntroText">
        {article.image && (
          <p>
            <a href={`/el/item/${article.slug}`}>
              <img src={article.image} alt={article.title} />
            </a>
          </p>
        )}
        <p>{article.intro}</p>
      </div>

      <div class="itemReadMore">
        <a class="k2ReadMore" href={`/el/item/${article.slug}`}>
          Περισσότερα...
        </a>
      </div>
    </div>
  </div>
</article>
