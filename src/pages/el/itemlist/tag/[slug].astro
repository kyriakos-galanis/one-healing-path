---
import Layout from '../../../../layouts/Layout.astro';
import ArticleCard from '../../../../components/ArticleCard.astro';
import siteData from '../../../../data/siteData.json';

export function getStaticPaths() {
  const paths: any[] = [];
  const addedSlugs = new Set<string>();

  for (const t of siteData.tags) {
    const articles = siteData.articles.filter((a) => a.tags && a.tags.includes(t.raw));
    
    const slugsToRegister = [
      t.slug,
      t.raw,
      encodeURIComponent(t.raw),
      t.raw.replace(/ /g, '%20'),
    ];

    for (const s of slugsToRegister) {
      if (s && !addedSlugs.has(s)) {
        addedSlugs.add(s);
        paths.push({
          params: { slug: s },
          props: { tag: t, articles },
        });
      }
    }
  }

  return paths;
}

const { tag, articles } = Astro.props;
---

<Layout 
  title={`Ετικέτα: ${tag.title} - onehealing.gr`}
  description={`Άρθρα με την ετικέτα ${tag.title} - One Healing.`}
  breadcrumbs={[
    { label: 'Αρχική', href: '/el/' },
    { label: 'Ιστολόγιο', href: '/el/istologio' },
    { label: `Ετικέτα: ${tag.title}` }
  ]}
>
  <div id="k2Container" class="itemListView" style="width: 100%;">
    <div class="itemListCategoriesBlock">
      <div class="itemsCategory">
        <h2>Ετικέτα: {tag.title}</h2>
      </div>
    </div>

    <div class="itemList">
      <div id="itemListLeading">
        {articles.map((article, idx) => (
          <div 
            class={`itemContainer ${idx % 2 === 1 ? 'itemContainerLast' : ''}`} 
            style="width: 49.9%; float: left; box-sizing: border-box; margin-bottom: 30px;"
          >
            <ArticleCard article={article} />
          </div>
        ))}
        <div class="clr" style="clear: both;"></div>
      </div>
    </div>
  </div>
</Layout>
