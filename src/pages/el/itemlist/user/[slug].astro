---
import Layout from '../../../../layouts/Layout.astro';
import ArticleCard from '../../../../components/ArticleCard.astro';
import siteData from '../../../../data/siteData.json';

export function getStaticPaths() {
  return [
    {
      params: { slug: '655-panagiwthsgkinhsmdcac' },
      props: { 
        author: 'Παναγιώτης Γκίνης MD, CAc',
        articles: siteData.articles,
      },
    },
  ];
}

const { author, articles } = Astro.props;
---

<Layout 
  title={`${author} - onehealing.gr`}
  description={`Άρθρα του ιατρού ${author} - One Healing.`}
  breadcrumbs={[
    { label: 'Αρχική', href: '/el/' },
    { label: 'Ιστολόγιο', href: '/el/istologio' },
    { label: author }
  ]}
>
  <div class="space-y-6">
    <header class="border-b border-[#ded8cf] pb-3 mb-6">
      <span class="text-xs uppercase tracking-wider text-gray-500">Συγγραφέας</span>
      <h1 class="text-2xl sm:text-3xl font-serif text-[#774737] mt-1">
        {author}
      </h1>
      <p class="text-xs text-gray-500 mt-1">
        {articles.length} δημοσιεύσεις
      </p>
    </header>

    <div class="divide-y divide-[#e9e3d8]">
      {articles.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </div>
</Layout>
