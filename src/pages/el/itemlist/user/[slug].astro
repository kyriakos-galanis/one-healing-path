---
import Layout from '../../../../layouts/Layout.astro';
import ArticleCard from '../../../../components/ArticleCard.astro';
import siteData from '../../../../data/siteData.json';

export function getStaticPaths() {
  return [
    {
      params: { slug: '655-panagiwthsgkinhsmdcac' },
      props: { 
        author: 'Παναγιώτης Γκίνης MD, CAc',
        articles: siteData.articles,
      },
    },
  ];
}

const { author, articles } = Astro.props;
---

<Layout 
  title={`${author} - onehealing.gr`}
  description={`Άρθρα του ιατρού ${author} - One Healing.`}
  breadcrumbs={[
    { label: 'Αρχική', href: '/el/' },
    { label: 'Ιστολόγιο', href: '/el/istologio' },
    { label: author }
  ]}
>
  <div id="k2Container" class="itemListView" style="width: 100%;">
    <div class="itemListCategoriesBlock">
      <div class="itemsCategory">
        <h2>Συγγραφέας: {author}</h2>
      </div>
    </div>

    <div class="itemList">
      <div id="itemListLeading">
        {articles.map((article, idx) => (
          <div 
            class={`itemContainer ${idx % 2 === 1 ? 'itemContainerLast' : ''}`} 
            style="width: 49.9%; float: left; box-sizing: border-box; margin-bottom: 30px;"
          >
            <ArticleCard article={article} />
          </div>
        ))}
        <div class="clr" style="clear: both;"></div>
      </div>
    </div>
  </div>
</Layout>
