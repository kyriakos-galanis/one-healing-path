---
import Layout from '../../../../layouts/Layout.astro';
import ArticleCard from '../../../../components/ArticleCard.astro';
import siteData from '../../../../data/siteData.json';

export function getStaticPaths() {
  const categories = siteData.categories;
  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: { 
      category: cat,
      articles: siteData.articles.filter((a) => a.category_slug === cat.slug),
    },
  }));
}

const { category, articles } = Astro.props;
---

<Layout 
  title={`${category.title} - onehealing.gr`}
  description={`Άρθρα στην κατηγορία ${category.title} - One Healing.`}
  breadcrumbs={[
    { label: 'Αρχική', href: '/el/' },
    { label: 'Ιστολόγιο', href: '/el/istologio' },
    { label: `Κατηγορία: ${category.title}` }
  ]}
>
  <div id="k2Container" class="itemListView" style="width: 100%;">
    <div class="itemListCategoriesBlock">
      <div class="itemsCategory">
        <h2>Κατηγορία: {category.title}</h2>
      </div>
    </div>

    <div class="itemList">
      <div id="itemListLeading">
        {articles.map((article, idx) => (
          <div 
            class={`itemContainer ${idx % 2 === 1 ? 'itemContainerLast' : ''}`} 
            style="width: 49.9%; float: left; box-sizing: border-box; margin-bottom: 30px;"
          >
            <ArticleCard article={article} />
          </div>
        ))}
        <div class="clr" style="clear: both;"></div>
      </div>
    </div>
  </div>
</Layout>
