---
import Layout from '../../../layouts/Layout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import siteData from '../../../data/siteData.json';

const articles = siteData.articles;
---

<Layout 
  title="Ιστολογιο - onehealing.gr"
  description="Άρθρα, νέα και απόψεις για τη σωματική και ψυχική υγεία, τον βελονισμό και το Τάι τσι από τον Παναγιώτη Γκίνη."
  breadcrumbs={[
    { label: 'Αρχική', href: '/el/' },
    { label: 'Ιστολόγιο' }
  ]}
>
  <div id="k2Container" class="itemListView" style="width: 100%;">
    <div class="itemListCategoriesBlock">
      <div class="itemsCategory">
        <h2>Ιστολόγιο</h2>
      </div>
    </div>

    <div class="itemList">
      <div id="itemListLeading">
        {articles.map((article, idx) => (
          <div 
            class={`itemContainer ${idx % 2 === 1 ? 'itemContainerLast' : ''}`} 
            style="width: 49.9%; float: left; box-sizing: border-box; margin-bottom: 30px;"
          >
            <ArticleCard article={article} />
          </div>
        ))}
        <div class="clr" style="clear: both;"></div>
      </div>
    </div>
  </div>
</Layout>
