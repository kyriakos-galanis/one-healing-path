---
import Layout from '../../layouts/Layout.astro';
import siteData from '../../data/siteData.json';

const testimonials = siteData.testimonials;
---

<Layout 
  title="Προσωπικες Μαρτυριες - onehealing.gr"
  description="Προσωπικές μαρτυρίες και εμπειρίες ασθενών από τη θεραπευτική αντιμετώπιση και το βελονισμό στο One Healing."
  breadcrumbs={[
    { label: 'Αρχική', href: '/el/' },
    { label: 'Προσωπικές Μαρτυρίες' }
  ]}
>
  <article class="bg-white">
    <header class="border-b border-[#ded8cf] pb-3 mb-6">
      <h1 class="text-2xl sm:text-3xl font-serif text-[#774737]">
        Προσωπικές Μαρτυρίες
      </h1>
      <p class="text-xs sm:text-sm text-gray-600 mt-2">
        Σε αυτή τη σελίδα φιλοξενούνται εμπειρίες φίλων από τη θεραπευτική αντιμετώπιση και από τις συμβουλές για την υγεία.
        <br />
        Εάν θέλετε να αφήσετε και εσείς κάποια λόγια για την εμπειρία σας, παρακαλούμε <a href="/el/epikoinonia" class="text-[#774737] underline font-medium">επικοινωνήστε εδώ</a>.
      </p>
    </header>

    <!-- Interactive Tabbed Testimonials Component -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 pt-2">
      <!-- Left Column: Tab List (4 cols) -->
      <div class="md:col-span-5 lg:col-span-4 border border-[#e4ded5] rounded-md bg-[#faf8f5] p-2 max-h-[620px] overflow-y-auto">
        <ul class="space-y-1" id="testimonial-tabs">
          {testimonials.map((t, idx) => (
            <li>
              <button 
                type="button"
                data-tab-index={idx}
                class={`w-full text-left px-3 py-2.5 rounded text-xs transition-colors testimonial-tab-btn flex flex-col items-start ${
                  idx === 0 
                    ? 'bg-[#774737] text-white font-semibold shadow-xs' 
                    : 'text-gray-700 hover:bg-[#ede7dd]'
                }`}
              >
                <span class="font-medium">{t.name}</span>
                {t.condition && (
                  <span class={`text-[11px] mt-0.5 ${idx === 0 ? 'text-[#a3e9ec]' : 'text-gray-500'}`}>
                    ({t.condition})
                  </span>
                )}
              </button>
            </li>
          ))}
        </ul>
      </div>

      <!-- Right Column: Testimonial Details (7-8 cols) -->
      <div class="md:col-span-7 lg:col-span-8 bg-[#fdfdfc] border border-[#e4ded5] rounded-md p-6 relative min-h-[350px]">
        {testimonials.map((t, idx) => (
          <div 
            id={`testimonial-content-${idx}`}
            class={`testimonial-pane space-y-4 ${idx === 0 ? 'block' : 'hidden'}`}
          >
            <div class="border-b border-[#ded8cf] pb-3 mb-4 flex items-center justify-between flex-wrap gap-2">
              <div>
                <h2 class="text-lg font-serif text-[#774737] font-semibold">
                  {t.name}
                </h2>
                {t.condition && (
                  <p class="text-xs text-gray-500 italic mt-0.5">
                    {t.condition}
                  </p>
                )}
              </div>
              <span class="text-xs bg-[#f4eee6] text-[#774737] px-2.5 py-1 rounded border border-[#e2dcce] font-medium">
                Μαρτυρία {t.id} / {testimonials.length}
              </span>
            </div>

            <!-- Content HTML -->
            <div class="prose max-w-none text-gray-700 leading-relaxed text-sm italic border-l-2 border-[#a3e9ec] pl-4 py-1" set:html={t.content} />
          </div>
        ))}
      </div>
    </div>
  </article>
</Layout>

<script>
  const buttons = document.querySelectorAll('.testimonial-tab-btn');
  const panes = document.querySelectorAll('.testimonial-pane');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetIndex = btn.getAttribute('data-tab-index');

      // Update button styles
      buttons.forEach((b) => {
        b.classList.remove('bg-[#774737]', 'text-white', 'font-semibold', 'shadow-xs');
        b.classList.add('text-gray-700');
        const conditionSpan = b.querySelector('span:last-child');
        if (conditionSpan) {
          conditionSpan.classList.remove('text-[#a3e9ec]');
          conditionSpan.classList.add('text-gray-500');
        }
      });

      btn.classList.add('bg-[#774737]', 'text-white', 'font-semibold', 'shadow-xs');
      btn.classList.remove('text-gray-700');
      const activeCondition = btn.querySelector('span:last-child');
      if (activeCondition) {
        activeCondition.classList.remove('text-gray-500');
        activeCondition.classList.add('text-[#a3e9ec]');
      }

      // Show target pane
      panes.forEach((pane) => {
        pane.classList.add('hidden');
        pane.classList.remove('block');
      });

      const targetPane = document.getElementById(`testimonial-content-${targetIndex}`);
      if (targetPane) {
        targetPane.classList.remove('hidden');
        targetPane.classList.add('block');
      }
    });
  });
</script>
