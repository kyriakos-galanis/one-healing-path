---
import Layout from '../../../layouts/Layout.astro';
import siteData from '../../../data/siteData.json';

export function getStaticPaths() {
  return siteData.articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;

const tagSlugMap: Record<string, string> = {
  'Βελονισμός': 'velonismos',
  'Τάι τσι': 'tai-tsi',
  'Ψυχιατρική': 'psychiatriki',
  'Ψυχοθεραπεία': 'psychotherapeia',
};
---

<Layout 
  title={`${article.title} - onehealing.gr`}
  description={article.intro}
  breadcrumbs={[
    { label: 'Αρχική', href: '/el/' },
    { label: 'Ιστολόγιο', href: '/el/istologio' },
    { label: article.title }
  ]}
>
  <article id="k2Container" class="itemView uk-margin-bottom" itemscope="" itemtype="https://schema.org/Article">
    <header>
      <time datetime={article.date} itemprop="dateCreated">
        <span class="uk-blog-date">
          <span class="tm-article-date-day">{article.date_day}</span>
        </span>
      </time>
      <h1 itemprop="name">
        {article.title}
      </h1>
      <ul>
        <li class="itemDateCreated">
          {article.date} |
        </li>
        <li class="itemAuthor" itemscope="" itemtype="https://schema.org/Person">
          Γράφτηκε από 
          <a href="/el/itemlist/user/655-panagiwthsgkinhsmdcac" rel="author">
            <span itemprop="name">{article.author}</span>
          </a>
        </li>
        <li class="itemCategory">
          <span>Κατηγορία</span> 
          <a href={`/el/itemlist/category/${article.category_slug}`}>
            {article.category}
          </a>
        </li>
      </ul>
    </header>

    <div class="itemBlock">
      <div class="itemBody" itemprop="articleBody">
        <div class="itemFullText" set:html={article.content_html} />

        {article.tags && article.tags.length > 0 && (
          <div class="itemLinks">
            <div class="itemTagsBlock">
              <span>Ετικέτες:</span>
              <ul class="itemTags">
                {article.tags.map((t: string) => {
                  const tagSlug = tagSlugMap[t] || encodeURIComponent(t);
                  return (
                    <li>
                      <a href={`/el/itemlist/tag/${tagSlug}`}>{t}</a>
                    </li>
                  );
                })}
              </ul>
              <div class="clr"></div>
            </div>
          </div>
        )}
      </div>
    </div>
  </article>
</Layout>
