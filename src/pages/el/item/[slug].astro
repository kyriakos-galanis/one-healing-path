---
import Layout from '../../../layouts/Layout.astro';
import siteData from '../../../data/siteData.json';

export function getStaticPaths() {
  return siteData.articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;

const tagSlugMap: Record<string, string> = {
  'Βελονισμός': 'velonismos',
  'Τάι τσι': 'tai-tsi',
  'Ψυχιατρική': 'psychiatriki',
  'Ψυχοθεραπεία': 'psychotherapeia',
};
---

<Layout 
  title={`${article.title} - onehealing.gr`}
  description={article.intro}
  breadcrumbs={[
    { label: 'Αρχική', href: '/el/' },
    { label: 'Ιστολόγιο', href: '/el/istologio' },
    { label: article.title }
  ]}
>
  <article class="bg-white">
    <header class="border-b border-[#ded8cf] pb-4 mb-6">
      <div class="flex items-start gap-4">
        <!-- Date Badge -->
        <div class="shrink-0 text-center bg-[#f4f1ea] border border-[#ded8cf] rounded px-3 py-2 min-w-[55px]">
          <span class="block text-2xl font-bold text-[#774737] leading-none">
            {article.date_day}
          </span>
          <span class="block text-[11px] uppercase text-gray-500 mt-0.5">
            {article.date.split(' ')[1]?.slice(0, 3)}
          </span>
        </div>

        <div class="flex-1">
          <h1 class="text-2xl sm:text-3xl font-serif text-[#32393c] leading-tight">
            {article.title}
          </h1>

          <!-- Meta -->
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500 mt-3">
            <span>{article.date}</span>
            <span class="text-gray-300">|</span>
            <span>
              Κατηγορία: 
              <a href={`/el/itemlist/category/${article.category_slug}`} class="text-[#774737] hover:underline font-medium">
                {article.category}
              </a>
            </span>
            <span class="text-gray-300">|</span>
            <span>
              Γράφτηκε από 
              <a href="/el/itemlist/user/655-panagiwthsgkinhsmdcac" class="text-gray-700 hover:text-[#774737] font-medium">
                {article.author}
              </a>
            </span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <div 
      class="article-content prose max-w-none text-gray-700 leading-relaxed text-sm sm:text-base space-y-4" 
      set:html={article.content_html} 
    />

    <!-- Tags Line -->
    {article.tags && article.tags.length > 0 && (
      <div class="mt-8 pt-4 border-t border-[#ded8cf] flex items-center gap-2 flex-wrap">
        <span class="text-xs font-semibold text-gray-600">Ετικέτες:</span>
        {article.tags.map((t: string) => {
          const tagSlug = tagSlugMap[t] || encodeURIComponent(t);
          return (
            <a 
              href={`/el/itemlist/tag/${tagSlug}`} 
              class="text-xs bg-[#f4f1ea] hover:bg-[#774737] hover:text-white text-[#774737] px-2.5 py-1 rounded transition-colors"
            >
              {t}
            </a>
          );
        })}
      </div>
    )}

    <!-- Author Box -->
    <div class="mt-8 p-4 bg-[#faf8f5] border border-[#ded8cf] rounded-md flex items-center gap-4">
      <img 
        src="/images/trxt.png" 
        alt="Παναγιώτης Γκίνης MD, CAc" 
        class="w-14 h-14 rounded-full object-cover border border-[#ded8cf]"
      />
      <div>
        <h3 class="font-semibold text-sm text-[#774737]">
          Παναγιώτης Γκίνης MD, CAc
        </h3>
        <p class="text-xs text-gray-500 mt-0.5">
          Ψυχίατρος - Ψυχοθεραπευτής - Βελονιστής. Εξειδίκευση στο Balance Method και στο Ψυχικό Τραύμα.
        </p>
        <a href="/el/viografiko" class="text-xs text-[#774737] hover:underline font-medium mt-1 inline-block">
          Περισσότερα στο βιογραφικό →
        </a>
      </div>
    </div>

    <!-- Back to blog link -->
    <div class="mt-6 text-center">
      <a href="/el/istologio" class="text-xs text-[#774737] hover:underline font-semibold uppercase tracking-wider">
        ← Επιστροφή στο Ιστολόγιο
      </a>
    </div>
  </article>
</Layout>
