---
import Layout from '../../layouts/Layout.astro';
import HeroSlideshow from '../../components/HeroSlideshow.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import siteData from '../../data/siteData.json';

const articles = siteData.articles;
---

<Layout 
  title="Αρχικη - onehealing.gr"
  description="One Healing - Ιατρός Παναγιώτης Γκίνης. Βελονισμός Balance Method Dr Tan, Ψυχοθεραπεία Trauma Informed, Ψυχιατρική."
  breadcrumbs={[{ label: 'Αρχική' }]}
>
  <div slot="hero">
    <HeroSlideshow />
  </div>

  <div id="k2Container" class="itemListView" style="width: 100%;">
    <div class="itemList">
      <div id="itemListLeading">
        {articles.map((article, idx) => (
          <div 
            class={`itemContainer ${idx % 2 === 1 ? 'itemContainerLast' : ''}`} 
            style="width: 49.9%; float: left; box-sizing: border-box; margin-bottom: 30px;"
          >
            <ArticleCard article={article} />
          </div>
        ))}
        <div class="clr" style="clear: both;"></div>
      </div>
    </div>
  </div>
</Layout>
