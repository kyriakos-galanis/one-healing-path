---
import Header from '../components/Header.astro';
import Navbar from '../components/Navbar.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  showSidebar?: boolean;
  breadcrumbs?: Array<{ label: string; href?: string }>;
}

const {
  title,
  description = "One Healing - Ιατρός Παναγιώτης Γκίνης. Βελονισμός, Ψυχοθεραπεία, Ψυχιατρική",
  keywords = "βελονισμός, ψυχοθεραπεία, ψυχιατρική, one healing, τάι τσι, αθήνα",
  showSidebar = true,
  breadcrumbs = [],
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="el" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Favicon & Touch Icons -->
    <link rel="shortcut icon" href="/templates/saffron/favicon.ico" type="image/vnd.microsoft.icon" />
    <link rel="apple-touch-icon-precomposed" href="/templates/saffron/apple_touch_icon.png" />

    <!-- Google Fonts for Saffron Theme -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css?family=Sarala&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Muli:200,300,400,700&display=swap" rel="stylesheet" />

    <!-- Exact Theme Stylesheets from onehealing.gr -->
    <link rel="stylesheet" href="/media/plg_system_jcemediabox/css/jcemediabox.min.css" />
    <link rel="stylesheet" href="/cache/widgetkit/widgetkit-63f999f4.css" />
    <link rel="stylesheet" href="/components/com_jevents/assets/css/jevcustom.css" />
    <link rel="stylesheet" href="/templates/saffron/html/com_jevents/geraint/assets/css/modstyle.css" />
    <link rel="stylesheet" href="/templates/saffron/styles/yassas/css/bootstrap.css" />
    <link rel="stylesheet" href="/templates/saffron/styles/yassas/css/theme.css" />
    <link rel="stylesheet" href="/templates/saffron/css/custom.css" />

    <!-- Theme & UIkit Scripts -->
    <script is:inline src="/media/jui/js/jquery.min.js"></script>
    <script is:inline src="/templates/saffron/warp/vendor/uikit/js/uikit.js"></script>
    <script is:inline src="/templates/saffron/js/core.js"></script>
    <script is:inline src="/templates/saffron/js/theme.js"></script>
  </head>

  <body id="tm-container" class="tm-sidebar-b-right tm-sidebars-1 tm-noblog">
    <!-- Main Sheet Container (Exact Centered Boxed Layout) -->
    <div class="uk-container uk-container-center tm-sheet">
      <!-- Top Toolbar and Headerbar -->
      <Header currentPath={currentPath} />

      <!-- Navigation Bar -->
      <Navbar currentPath={currentPath} />

      <!-- Optional Hero / Slider Slot -->
      <slot name="hero" />

      <!-- Breadcrumb Bar -->
      {breadcrumbs.length > 0 && (
        <ul class="uk-breadcrumb">
          {breadcrumbs.map((b, idx) => (
            idx === breadcrumbs.length - 1 ? (
              <li class="uk-active">
                <span>{b.label}</span>
              </li>
            ) : (
              <li>
                <a href={b.href || '#'}>{b.label}</a>
              </li>
            )
          ))}
        </ul>
      )}

      <!-- Main Middle Area -->
      <div class="tm-middle uk-grid" data-uk-grid-match="" data-uk-grid-margin="">
        {showSidebar ? (
          <div class="tm-main uk-width-medium-3-4">
            <main class="tm-content">
              <slot />
            </main>
          </div>
          <aside class="tm-sidebar-b uk-width-medium-1-4">
            <Sidebar />
          </aside>
        ) : (
          <div class="tm-main uk-width-1-1">
            <main class="tm-content">
              <slot />
            </main>
          </div>
        )}
      </div>

      <!-- Footer -->
      <Footer />
    </div>

    <!-- Offcanvas Mobile Drawer -->
    <div id="offcanvas" class="uk-offcanvas">
      <div class="uk-offcanvas-bar uk-offcanvas-bar-flip">
        <div class="uk-panel">
          <form class="uk-search" action="/el/istologio" method="get">
            <input class="uk-search-field" type="text" name="q" placeholder="Αναζήτηση..." />
          </form>
        </div>
        <ul class="uk-nav uk-nav-parent-icon uk-nav-offcanvas" data-uk-nav="{}">
          <li class={currentPath === '/el/' || currentPath === '/el' ? 'uk-active' : ''}>
            <a href="/el/">Αρχικη</a>
          </li>
          <li class={currentPath.includes('/viografiko') ? 'uk-active' : ''}>
            <a href="/el/viografiko">Βιογραφικo</a>
          </li>
          <li class={`uk-parent ${currentPath.includes('/therapeftiki-proseggisi') ? 'uk-active uk-open' : ''}`}>
            <a href="/el/therapeftiki-proseggisi">Θεραπευτικη Προσεγγιση</a>
            <ul class="uk-nav-sub">
              <li><a href="/el/therapeftiki-proseggisi/velonismos">Βελονισμός</a></li>
              <li><a href="/el/therapeftiki-proseggisi/onehealing">Ψυχοθεραπεία</a></li>
              <li><a href="/el/therapeftiki-proseggisi/psychiatriki">Ψυχιατρική</a></li>
            </ul>
          </li>
          <li class={currentPath.includes('/syxnes-erotiseis') ? 'uk-active' : ''}>
            <a href="/el/syxnes-erotiseis">Συχνες Ερωτησεις</a>
          </li>
          <li class={currentPath.includes('/istologio') ? 'uk-active' : ''}>
            <a href="/el/istologio">Ιστολογιο</a>
          </li>
          <li class={currentPath.includes('/prosopikes-martyries') ? 'uk-active' : ''}>
            <a href="/el/prosopikes-martyries">Προσωπικες Μαρτυριες</a>
          </li>
          <li class={currentPath.includes('/epikoinonia') ? 'uk-active' : ''}>
            <a href="/el/epikoinonia">Επικοινωνια</a>
          </li>
        </ul>
      </div>
    </div>
  </body>
</html>
